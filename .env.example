# Signs admin login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="generate-a-long-random-string"

# Live domain, used for SEO tags, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL="https://www.your-domain.com"

# Optional. Folder holding content.json (default ./data — the committed file itself).
# On Render this is the persistent disk: /var/data
# DATA_DIR="./data"

# Optional. Folder for uploaded photos (default ./storage/uploads).
# UPLOAD_DIR="./storage/uploads"

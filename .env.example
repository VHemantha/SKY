# PostgreSQL (e.g. Neon / Netlify DB).
# DATABASE_URL: pooled connection, with pgbouncer=true when using a pooler.
# DIRECT_URL:   direct (unpooled) connection, used for migrations.
# For a local database, both can be the same URL.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require"

SESSION_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_SITE_URL="https://www.your-domain.com"
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="change-me"

# Local development only: where uploaded photos are saved.
# On Netlify, uploads are stored in Netlify Blobs automatically.
UPLOAD_DIR="./storage/uploads"
